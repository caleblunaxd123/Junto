# Base de datos
DATABASE_URL=postgresql://junto_user:junto_password@localhost:5432/junto_db

# JWT
JWT_SECRET=super_secret_key_minimo_32_caracteres_cambia_esto_en_produccion
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Email (OTP de verificación y recuperación). Obligatorio en producción.
# Opción A (recomendada): Resend — verifica tu dominio en resend.com
RESEND_API_KEY=
EMAIL_FROM="JUNTO <no-reply@junto.pe>"
# Opción B: SMTP (Amazon SES, Gmail con contraseña de aplicación, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sin proveedor no se envía nada. En desarrollo, EMAIL_DEV_LOG=true imprime el correo (con el código) en la consola;
# sin esa variable solo se registra que no se envió. Nunca lo actives en un servidor compartido.
EMAIL_DEV_LOG=
# Clave para el hash de destinatarios de «Enviar desde JUNTO» (si falta, se usa JWT_SECRET)
EMAIL_HASH_SECRET=

# Expo Push Service. FCM v1 se configura en el proyecto de Expo/EAS, no en esta API.
# Si activas la seguridad de acceso al servicio push de Expo, configura este secreto solo en el servidor.
EXPO_ACCESS_TOKEN=

# Continuar con Google: IDs de cliente OAuth aceptados como audiencia del token, separados por comas.
# Usa el ID del cliente "Aplicación web" (el mismo que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID en la app).
GOOGLE_CLIENT_IDS=

# Web pública servida por esta API (invitaciones, privacidad, eliminar cuenta)
PUBLIC_WEB_URL=https://junto.pe
SUPPORT_EMAIL=soporte@junto.pe
LEGAL_OWNER=
ANDROID_PACKAGE=com.junto.app
# Huellas SHA-256 del certificado de firma (Play Console → Integridad de la app), separadas por comas
ANDROID_SHA256_CERT_FINGERPRINTS=
PLAY_STORE_URL=

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=exp://192.168.1.x:8081

# IA local (solo backend; nunca exponer la clave en Expo)
JUNTO_AI_BASE_URL=https://ia.lunalav.pe
JUNTO_AI_API_KEY=

# Monitoreo de errores (opcional). Sin DSN no se envía nada.
SENTRY_DSN=
