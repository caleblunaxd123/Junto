generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String    @db.VarChar(100)
  email            String    @unique @db.VarChar(255)
  celular          String?   @db.VarChar(12)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  fotoUrl          String?   @map("foto_url") @db.VarChar(500)
  emailVerificado  Boolean   @default(false) @map("email_verificado")
  otpCode          String?   @map("otp_code") @db.VarChar(6)
  otpExpires       DateTime? @map("otp_expires")
  otpPurpose       String?   @map("otp_purpose") @db.VarChar(20)
  otpAttempts      Int       @default(0) @map("otp_attempts")
  fechaRegistro    DateTime  @default(now()) @map("fecha_registro")
  activo           Boolean   @default(true)
  expoPushToken    String?   @map("expo_push_token") @db.VarChar(200)
  // Google account ("sub" claim) linked to this user for "Continuar con Google".
  googleId         String?   @unique @map("google_id") @db.VarChar(64)
  // Set when the person deletes the account: the row is anonymized, never reused.
  fechaEliminacion DateTime? @map("fecha_eliminacion")

  // Relations
  gruposCreados       Grupo[]           @relation("GrupoCreador")
  grupoMiembros       GrupoMiembro[]
  gastosRegistrados   Gasto[]           @relation("GastoCreador")
  gastosPagados       Gasto[]           @relation("GastoPagador")
  gastoParticipantes  GastoParticipante[]
  pagosPagador        Pago[]            @relation("PagoPagador")
  pagosReceptor       Pago[]            @relation("PagoReceptor")
  recordatoriosEnviados Recordatorio[]  @relation("RecordatorioEnviador")
  recordatoriosRecibidos Recordatorio[] @relation("RecordatorioReceptor")
  configRecordatorios ConfigRecordatorio[]
  refreshTokens       RefreshToken[]
  cuentasRapidas      CuentaRapida[]
  correosCompartidos  CorreoCompartido[]
  invitacionesRecibidas Invitacion[]    @relation("InvitacionInvitado")
  invitacionesEnviadas  Invitacion[]    @relation("InvitacionAnfitrion")
  pagosResueltos      Pago[]            @relation("PagoResolutor")
  comprobantes        Comprobante[]
  comentarios         Comentario[]
  reportesComentarios ReporteComentario[]
  recibosPush         ReciboPush[]
  avisosRecibidos     AvisoGrupo[] @relation("AvisoDestinatario")
  avisosOriginados    AvisoGrupo[] @relation("AvisoIntegrante")

  @@map("usuarios")
}

// Short-lived delivery metadata only: never notification bodies, amounts or group data.
// "aceptado" means Expo queued it, not that the person saw it. Purged after 24 h.
model ReciboPush {
  ticketId        String    @id @map("ticket_id") @db.VarChar(200)
  usuarioId       String    @map("usuario_id") @db.Uuid
  token           String    @db.VarChar(200)
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")
  ultimaConsulta  DateTime? @map("ultima_consulta")
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([fechaCreacion, ultimaConsulta])
  @@map("recibos_push")
}

// Organizer-managed bills: named guests are NOT fabricated registered users.
model CuentaRapida {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creadoPor      String   @map("creado_por") @db.Uuid
  nombre         String   @db.VarChar(100)
  datos          Json
  recibidos      Json     @default("[]")
  aportes        Json     @default("{}")
  historial      Json     @default("[]")
  archivada      Boolean  @default(false)
  solicitudId    String?  @map("solicitud_id") @db.VarChar(80)
  version        Int      @default(1)
  fechaCreacion  DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion DateTime @default(now()) @updatedAt @map("fecha_actualizacion")
  creador        Usuario  @relation(fields: [creadoPor], references: [id])

  @@index([creadoPor, fechaCreacion])
  @@unique([creadoPor, solicitudId])
  @@map("cuentas_rapidas")
}

model Grupo {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String    @db.VarChar(100)
  descripcion     String?   @db.Text
  tipo            String    @default("amigos") @db.VarChar(20)
  creadoPor       String    @map("creado_por") @db.Uuid
  linkInvitacion  String?   @unique @map("link_invitacion") @db.VarChar(50)
  fechaCreacion   DateTime  @default(now()) @map("fecha_creacion")
  activo          Boolean   @default(true)
  // Who may approve a reported payment: "receptor" (only who receives it) or "administrador"
  // (who receives it or a group admin). The payer never approves their own payment.
  aprobacionPagos String    @default("receptor") @map("aprobacion_pagos") @db.VarChar(20)

  // Relations
  creador         Usuario           @relation("GrupoCreador", fields: [creadoPor], references: [id])
  miembros        GrupoMiembro[]
  gastos          Gasto[]
  pagos           Pago[]
  recordatorios   Recordatorio[]
  configRecordatorio ConfigRecordatorio[]
  comprobantes    Comprobante[]
  comentarios     Comentario[]
  invitaciones    Invitacion[]
  avisos          AvisoGrupo[]

  @@map("grupos")
}

model GrupoMiembro {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId     String    @map("grupo_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  rol         String    @default("miembro") @db.VarChar(10)
  fechaUnion  DateTime  @default(now()) @map("fecha_union")
  activo      Boolean   @default(true)

  // Relations
  grupo       Grupo     @relation(fields: [grupoId], references: [id])
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
  @@map("grupo_miembros")
}

// Saved in the same transaction as joining. Push is optional, the in-app notice is durable.
model AvisoGrupo {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId      String   @map("grupo_id") @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  integranteId String   @map("integrante_id") @db.Uuid
  fecha        DateTime @default(now())
  leido        Boolean  @default(false)
  grupo        Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation("AvisoDestinatario", fields: [usuarioId], references: [id], onDelete: Cascade)
  integrante   Usuario  @relation("AvisoIntegrante", fields: [integranteId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leido, fecha])
  @@map("avisos_grupo")
}

model Gasto {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId      String    @map("grupo_id") @db.Uuid
  descripcion  String    @db.VarChar(200)
  montoTotal   Int       @map("monto_total") // en centavos
  pagadoPor    String    @map("pagado_por") @db.Uuid
  categoria    String    @default("otro") @db.VarChar(30)
  fecha        DateTime  @default(now())
  creadoPor    String    @map("creado_por") @db.Uuid
  fotoUrl      String?   @map("foto_url") @db.VarChar(500)
  notas        String?   @db.Text
  activo       Boolean   @default(true)
  // Client-generated key: a double tap or a retry after a timeout returns the same expense.
  solicitudId  String?   @map("solicitud_id") @db.VarChar(80)

  // Relations
  grupo        Grupo               @relation(fields: [grupoId], references: [id])
  pagador      Usuario             @relation("GastoPagador", fields: [pagadoPor], references: [id])
  creador      Usuario             @relation("GastoCreador", fields: [creadoPor], references: [id])
  participantes GastoParticipante[]
  comentarios  Comentario[]

  @@index([grupoId])
  @@unique([creadoPor, solicitudId])
  @@map("gastos")
}

model GastoParticipante {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gastoId         String    @map("gasto_id") @db.Uuid
  usuarioId       String    @map("usuario_id") @db.Uuid
  montoAsignado   Int       @map("monto_asignado") // en centavos
  pagado          Boolean   @default(false)
  fechaPago       DateTime? @map("fecha_pago")

  // Relations
  gasto           Gasto     @relation(fields: [gastoId], references: [id])
  usuario         Usuario   @relation(fields: [usuarioId], references: [id])

  @@unique([gastoId, usuarioId])
  @@index([gastoId])
  @@index([usuarioId])
  @@map("gasto_participantes")
}

model Pago {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId         String    @map("grupo_id") @db.Uuid
  pagadorId       String    @map("pagador_id") @db.Uuid
  receptorId      String    @map("receptor_id") @db.Uuid
  monto           Int       // en centavos
  feejunto        Int?      @map("fee_junto") // en centavos
  metodo          String?   @db.VarChar(20)
  culqiChargeId   String?   @map("culqi_charge_id") @db.VarChar(100)
  estado          String    @default("pendiente") @db.VarChar(20)
  fechaPago       DateTime  @default(now()) @map("fecha_pago")
  nota            String?   @db.VarChar(100)
  fechaResolucion DateTime? @map("fecha_resolucion")
  // Who approved or rejected it: the receiver or, when the group allows it, an admin.
  resueltoPor     String?   @map("resuelto_por") @db.Uuid

  // Relations
  grupo           Grupo     @relation(fields: [grupoId], references: [id])
  pagador         Usuario   @relation("PagoPagador", fields: [pagadorId], references: [id])
  receptor        Usuario   @relation("PagoReceptor", fields: [receptorId], references: [id])
  resolutor       Usuario?  @relation("PagoResolutor", fields: [resueltoPor], references: [id])
  comprobante     Comprobante?
  comentarios     Comentario[]

  @@index([pagadorId])
  // The ledger reads every payment of a group; approvers look up payments addressed to them.
  @@index([grupoId])
  @@index([receptorId])
  @@map("pagos")
}

model Recordatorio {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enviadoPor    String    @map("enviado_por") @db.Uuid
  enviadoA      String    @map("enviado_a") @db.Uuid
  grupoId       String    @map("grupo_id") @db.Uuid
  monto         Int?      // en centavos
  tipo          String    @db.VarChar(20)
  tono          String    @default("suave") @db.VarChar(20)
  mensaje       String?   @db.Text
  leido         Boolean   @default(false)
  fechaEnvio    DateTime  @default(now()) @map("fecha_envio")
  fechaLectura  DateTime? @map("fecha_lectura")

  // Relations
  enviador      Usuario   @relation("RecordatorioEnviador", fields: [enviadoPor], references: [id])
  receptor      Usuario   @relation("RecordatorioReceptor", fields: [enviadoA], references: [id])
  grupo         Grupo     @relation(fields: [grupoId], references: [id])

  @@index([enviadoA])
  @@map("recordatorios")
}

model ConfigRecordatorio {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId          String    @map("grupo_id") @db.Uuid
  configuradoPor   String    @map("configurado_por") @db.Uuid
  activo           Boolean   @default(true)
  frecuenciaDias   Int       @default(7) @map("frecuencia_dias")
  horaEnvio        String    @default("09:00") @map("hora_envio")
  fechaInicio      DateTime  @default(now()) @map("fecha_inicio")

  // Relations
  grupo            Grupo     @relation(fields: [grupoId], references: [id])
  configurador     Usuario   @relation(fields: [configuradoPor], references: [id])

  @@map("config_recordatorios")
}

model RefreshToken {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  token            String    @db.VarChar(500)
  fechaExpiracion  DateTime  @map("fecha_expiracion")
  revocado         Boolean   @default(false)
  fechaCreacion    DateTime  @default(now()) @map("fecha_creacion")

  // Relations
  usuario          Usuario   @relation(fields: [usuarioId], references: [id])

  @@map("refresh_tokens")
}

// Summaries a person asked JUNTO to e-mail on their behalf. Kept for idempotency, rate limits and
// the visible status; the recipient is stored only as a keyed hash and a masked address.
model CorreoCompartido {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId           String   @map("usuario_id") @db.Uuid
  solicitudId         String   @map("solicitud_id") @db.VarChar(80)
  recursoTipo         String   @map("recurso_tipo") @db.VarChar(20)
  recursoId           String   @map("recurso_id") @db.Uuid
  destinatarioHash    String   @map("destinatario_hash") @db.VarChar(64)
  destinatarioMascara String   @map("destinatario_mascara") @db.VarChar(80)
  // enviando | aceptado | fallido | incierto. "aceptado" = the provider took it, not delivered/read.
  estado              String   @db.VarChar(12)
  proveedorId         String?  @map("proveedor_id") @db.VarChar(200)
  fechaCreacion       DateTime @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime @default(now()) @updatedAt @map("fecha_actualizacion")
  usuario             Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, solicitudId])
  @@index([usuarioId, fechaCreacion])
  @@map("correos_compartidos")
}

// A Yape/Plin/transfer screenshot uploaded as evidence of a payment. Starts as a draft (pagoId null)
// while the payer reviews what was read, and is linked when the payment is reported. Yape and Plin
// offer no API to verify person-to-person transfers, so this is evidence for a human approval.
model Comprobante {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subidoPor         String    @map("subido_por") @db.Uuid
  grupoId           String    @map("grupo_id") @db.Uuid
  pagoId            String?   @unique @map("pago_id") @db.Uuid
  // SHA-256 of the image bytes: the same screenshot cannot back two payments.
  hash              String    @db.Char(64)
  // What OCR read; the reported payment keeps the values the payer confirmed.
  app               String?   @db.VarChar(20)
  montoLeido        Int?      @map("monto_leido") // en centavos
  operacion         String?   @db.VarChar(24)
  destinatarioLeido String?   @map("destinatario_leido") @db.VarChar(80)
  fechaLeida        DateTime? @map("fecha_leida") @db.Date
  codigoSeguridad   String?   @map("codigo_seguridad") @db.VarChar(6)
  fechaCreacion     DateTime  @default(now()) @map("fecha_creacion")

  subidor Usuario            @relation(fields: [subidoPor], references: [id])
  grupo   Grupo              @relation(fields: [grupoId], references: [id])
  pago    Pago?              @relation(fields: [pagoId], references: [id])
  imagen  ComprobanteImagen?

  @@index([subidoPor, fechaCreacion])
  @@index([hash])
  @@index([operacion])
  @@map("comprobantes")
}

// The image lives apart so that listing payments never loads it; deleting the row purges it.
model ComprobanteImagen {
  comprobanteId String      @id @map("comprobante_id") @db.Uuid
  mime          String      @db.VarChar(20)
  datos         Bytes
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@map("comprobante_imagenes")
}

// Short comments on an expense or a payment, visible to the active members of the group.
model Comentario {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId       String   @map("grupo_id") @db.Uuid
  gastoId       String?  @map("gasto_id") @db.Uuid
  pagoId        String?  @map("pago_id") @db.Uuid
  autorId       String   @map("autor_id") @db.Uuid
  texto         String   @db.VarChar(500)
  // Deleted comments keep their place in the thread but lose their text.
  eliminado     Boolean  @default(false)
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  grupo    Grupo               @relation(fields: [grupoId], references: [id])
  gasto    Gasto?              @relation(fields: [gastoId], references: [id])
  pago     Pago?               @relation(fields: [pagoId], references: [id])
  autor    Usuario             @relation(fields: [autorId], references: [id])
  reportes ReporteComentario[]

  @@index([gastoId, fechaCreacion])
  @@index([pagoId, fechaCreacion])
  @@index([autorId, fechaCreacion])
  @@map("comentarios")
}

model ReporteComentario {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comentarioId  String     @map("comentario_id") @db.Uuid
  usuarioId     String     @map("usuario_id") @db.Uuid
  motivo        String?    @db.VarChar(200)
  fechaCreacion DateTime   @default(now()) @map("fecha_creacion")
  comentario    Comentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)
  usuario       Usuario    @relation(fields: [usuarioId], references: [id])

  @@unique([comentarioId, usuarioId])
  @@map("reportes_comentarios")
}

// Someone added by e-mail or phone is only invited: nothing of the group is shared with them, and
// they are not shared with the group, until they accept.
model Invitacion {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId        String    @map("grupo_id") @db.Uuid
  invitadoId     String    @map("invitado_id") @db.Uuid
  invitadoPor    String    @map("invitado_por") @db.Uuid
  // pendiente | aceptada | rechazada
  estado         String    @default("pendiente") @db.VarChar(12)
  fechaCreacion  DateTime  @default(now()) @map("fecha_creacion")
  fechaRespuesta DateTime? @map("fecha_respuesta")

  grupo          Grupo     @relation(fields: [grupoId], references: [id])
  invitado       Usuario   @relation("InvitacionInvitado", fields: [invitadoId], references: [id])
  anfitrion      Usuario   @relation("InvitacionAnfitrion", fields: [invitadoPor], references: [id])

  @@unique([grupoId, invitadoId])
  @@index([invitadoId, estado])
  @@index([invitadoPor, fechaCreacion])
  @@map("invitaciones")
}
