{
  "expo": {
    "name": "JUNTO",
    "slug": "junto",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-v2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.junto.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-v2.png",
        "backgroundColor": "#FFFCF7"
      },
      "package": "com.junto.app",
      "versionCode": 7
    },
    "web": {
      "favicon": "./assets/brand/favicon-v2.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-v2.png",
          "color": "#00856A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "scheme": "junto",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "188be768-affc-4f07-979e-094b472f54f3"
      }
    },
    "owner": "calebluna41"
  }
}
