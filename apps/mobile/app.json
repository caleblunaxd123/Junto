{
  "expo": {
    "name": "Junto",
    "slug": "junto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-v2.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand/splash-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFCF7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.junto.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-v2.png",
        "backgroundColor": "#FFFCF7"
      },
      "package": "com.junto.app"
    },
    "web": {
      "favicon": "./assets/brand/favicon-v2.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/notification-v2.png",
          "color": "#00856A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "scheme": "junto",
    "experiments": {
      "typedRoutes": true
    }
  }
}
